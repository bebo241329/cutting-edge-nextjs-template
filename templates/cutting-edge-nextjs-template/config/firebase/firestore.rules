rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userData(uid) {
      return userDoc(uid).data;
    }

    function getUserRole() {
      return userData(request.auth.uid).role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isAdminOrManager() {
      return isAuthenticated()
        && (getUserRole() == 'admin' || getUserRole() == 'manager');
    }

    function isActiveUser(uid) {
      return userData(uid).isActive == true;
    }

    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAuthenticated();

      allow update: if isAuthenticated() && (
        (
          request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive'])
        ) || isAdmin()
      );

      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /example-entities/{entityId} {
      allow read, write: if isAdminOrManager() && isActiveUser(request.auth.uid);
    }
  }
}
